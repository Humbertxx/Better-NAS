# Container paths — what the Go code reads.
VAULT_PATH=/vault
INBOX_PATH=/inbox

# Host paths bind-mounted onto the above. The contract paths are
# /mnt/nas/vault and /mnt/nas/inbox; this machine runs the live vault
# from /home/humbertx/vault until the NAS mount exists.

HOST_VAULT_PATH=/mnt/nas/vault
HOST_INBOX_PATH=/mnt/nas/inbox