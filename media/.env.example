PUID=1000
PGID=1000
TZ=America/New_York

# App config lives with this stack (copy existing linuxserver/Jellyfin/Seerr
# dirs into ./config/<service>). Library data does not: it lives on the
# NAS, outside this repo.
CONFIG_PATH=./config
MEDIA_PATH=/mnt/nas/library

# NordVPN OpenVPN. Set SERVER_COUNTRIES in your .env (Gluetun list,
# e.g. Switzerland). Leave empty to let Gluetun pick any Nord server.
VPN_TYPE=openvpn
OPENVPN_USER=
OPENVPN_PASSWORD=
SERVER_COUNTRIES=

# Gluetun HTTP control API (failback). Must be a Gluetun genkey value:
#   docker run --rm qmcgaw/gluetun genkey
GLUETUN_API_KEY=

# Internal ports — Caddy will publish these later. Compose does not bind
# them on the host. In-network HTTP:
#   gluetun:8080  qBittorrent WebUI (shared namespace)
#   gluetun:8000  Gluetun control API
#   gluetun:8888  Gluetun HTTP proxy (Prowlarr egress)
#   seerr:5055  sonarr:8989  radarr:7878  prowlarr:9696  jellyfin:8096
#
# Reused *arr/qbit config: change save/root folders to
#   /data/downloads  /data/movies  /data/tv
# (old /downloads or /media paths will not match this mount.)
