.directory
.Trash-*/
 
# === PROJECT-SPECIFIC ===
# vault-harvester outputs
wiki/hot.md.backup
harvest.log
 
# vault-save captures (use vault instead)
captures/
 
# vault-watch pid
*.pid
 
# Local test files
test-*.md
debug-*
 
# Git credentials cache (after Phase 5.5, don't commit)
~/.git-credentials
 
# === CI/CD ===
.github/workflows/secrets.yml
.gitlabci.yml.local
 
# === CLAUDE/CURSOR CONTEXT ===
claude_desktop_config.json.backup
mcp.json.backup
 
# === NAS-SPECIFIC ===
/home/*/.ssh/id_* # SSH keys on NAS
/home/*/vault-backup-lock
/home/*/.bash_history
 
