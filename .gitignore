# === GO BINARIES & BUILDS ===
bin/
dist/
*.exe
*.exe~
*.dll
*.so
*.so.*
*.dylib
vault-harvester
vault-save
vault-watch
vault-mcp
cmd/*/[a-z]* # Don't commit built binaries in cmd dirs
 
# === GO DEPENDENCIES ===
vendor/
go.sum
go.mod.backup
 
# === NODE/MCP ===
node_modules/
package-lock.json
yarn.lock
dist/
build/
 
# === OBSIDIAN VAULT (DO NOT COMMIT) ===
# Keep vault in GitHub separately via Obsidian Git plugin
config/obsidian-vault/
# Exception: commit template structure only
!config/obsidian-vault/.gitkeep
!config/obsidian-vault/Templates/
 
# === OBSIDIAN LOCAL SETTINGS ===
.obsidian/workspace.json
.obsidian/cache/
.obsidian/sync/
.obsidian/plugins/*/main.js
.obsidian/plugins/*/.esbuild/
 
# === IDE & EDITOR ===
.vscode/
.vscode-server/
.cursor/
.idea/
*.swp
*.swo
*~
.DS_Store
.AppleDouble
.LSOverride
*.sublime-workspace
*.sublime-project
*.code-workspace
 
# === TAILSCALE ===
state.tailscale.json
tailscale-derp.log
 
