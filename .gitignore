# === SECRETS ===
.env
.env.local
.env.*.local
**/.env
*.key
*.pem
credentials.json
oauth2.json

# TLS material (directory mount — never individual files)
certs/

# Nested git repo (CouchDB data, Obsidian runtime) — not this stack
ai-brain/

# === RUNTIME DATA (keep stack source tracked) ===
*-data/
couchdb-data/
n8n-data/
etc-pihole/
obsidian-config/
media/config/*
!media/config/.gitkeep

# Bridge runtime + live config (holds CouchDB creds).
# Ignore contents, not the directory, so the example can be committed.
**/bridge-dat/*
!**/bridge-dat/config.json.example
!**/bridge-dat/.gitkeep

# === BUILD
bin/
dist/
build/
vendor/
node_modules/
*.exe
*.dll
*.so
*.dylib
*.o
*.a
*.out
*.test

# === LOGS / TEMP ===
*.log
*.log.*
logs/
tmp/
temp/
*.tmp
*.pid
captures/
*.backup.json
*.couch
couchdb-backup/

# === IDE / OS ===
.vscode/
.vscode-server/
.cursor/
.idea/
*.swp
*.swo
*~
.DS_Store
.AppleDouble
.LSOverride
._*
.directory
.Trash-*/
Thumbs.db

# === LOCAL OVERRIDES ===
docker-compose.override.yml
*.service.local
systemd-override/
